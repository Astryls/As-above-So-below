<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Skylight zone painting joins the vanilla Zone architect category,
       right where the roof area tools live. The designators hide themselves
       on maps with no level below. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/DesignationCategoryDef[defName="Zone"]/specialDesignatorClasses</xpath>
    <value>
      <li>AsAboveSoBelow.Designator_ABSkylightExpand</li>
      <li>AsAboveSoBelow.Designator_ABSkylightClear</li>
    </value>
  </Operation>

</Patch>

<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <WorkGiverDef>
    <defName>AB_HaulAcrossLevels</defName>
    <label>haul things to other levels</label>
    <giverClass>AsAboveSoBelow.WorkGiver_ABHaulAcrossLevels</giverClass>
    <workType>Hauling</workType>
    <verb>haul</verb>
    <gerund>hauling</gerund>
    <priorityInType>10</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <!-- Bulk variant: inert unless Pick Up And Haul / Hauler's Dream is present
       and the pawn carries their inventory comp (runtime-gated in ShouldSkip).
       Same priorityInType as the single-item giver, which stands down for
       those pawns so exactly one fires. -->
  <WorkGiverDef>
    <defName>AB_BulkHaulAcrossLevels</defName>
    <label>bulk haul things to other levels</label>
    <giverClass>AsAboveSoBelow.WorkGiver_ABBulkHaulAcrossLevels</giverClass>
    <workType>Hauling</workType>
    <verb>haul</verb>
    <gerund>hauling</gerund>
    <priorityInType>10</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <!-- Allow Tool priority hauling across levels: urgently-designated stacks
       whose better storage is on a linked level cross FIRST. High
       priorityInType puts it ahead of ordinary hauling. Inert unless Allow
       Tool is installed (runtime-gated in ShouldSkip). -->
  <WorkGiverDef>
    <defName>AB_HaulUrgentlyAcrossLevels</defName>
    <label>haul things urgently to other levels</label>
    <giverClass>AsAboveSoBelow.WorkGiver_ABHaulUrgentlyAcrossLevels</giverClass>
    <workType>Hauling</workType>
    <verb>haul urgently</verb>
    <gerund>hauling urgently</gerund>
    <priorityInType>100</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>AB_RescueAcrossLevels</defName>
    <label>rescue to other levels</label>
    <giverClass>AsAboveSoBelow.WorkGiver_ABRescueAcrossLevels</giverClass>
    <workType>Doctor</workType>
    <verb>rescue</verb>
    <gerund>rescuing</gerund>
    <priorityInType>70</priorityInType>
    <emergency>true</emergency>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>AB_WardenTakeToBedAcrossLevels</defName>
    <label>take prisoners to cells on other levels</label>
    <giverClass>AsAboveSoBelow.WorkGiver_ABWardenTakeToBedAcrossLevels</giverClass>
    <workType>Warden</workType>
    <verb>take</verb>
    <gerund>taking to a cell</gerund>
    <priorityInType>85</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>AB_SupplyConstructionAcrossLevels</defName>
    <label>supply construction on other levels</label>
    <giverClass>AsAboveSoBelow.WorkGiver_ABSupplyConstruction</giverClass>
    <workType>Construction</workType>
    <verb>supply</verb>
    <gerund>supplying</gerund>
    <priorityInType>5</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>AB_TakeToPenAcrossLevels</defName>
    <label>take animals to pens on other levels</label>
    <giverClass>AsAboveSoBelow.WorkGiver_ABTakeToPenAcrossLevels</giverClass>
    <workType>Handling</workType>
    <verb>take</verb>
    <gerund>taking</gerund>
    <priorityInType>25</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>AB_FetchFromOtherLevels</defName>
    <label>fetch things from other levels</label>
    <giverClass>AsAboveSoBelow.WorkGiver_ABFetchFromOtherLevels</giverClass>
    <workType>Hauling</workType>
    <verb>fetch</verb>
    <gerund>fetching from</gerund>
    <priorityInType>8</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

</Defs>

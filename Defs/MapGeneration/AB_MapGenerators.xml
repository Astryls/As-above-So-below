<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <MapGeneratorDef>
    <defName>AB_Basement</defName>
    <label>basement level</label>
    <isUnderground>true</isUnderground>
    <ignoreAreaRevealedLetter>true</ignoreAreaRevealedLetter>
    <disableCallAid>true</disableCallAid>
    <pocketMapProperties>
      <biome>AB_Underground</biome>
      <temperature>12</temperature>
      <!-- Explicit (vanilla default): the level dies with the surface map, no orphans. -->
      <destroyOnParentMapAbandoned>true</destroyOnParentMapAbandoned>
    </pocketMapProperties>
    <genSteps>
      <li>AB_SolidRock</li>
      <!-- Both no-op unless the matching basement-environment setting is chosen;
           mutually exclusive by settings. CavernCarve = Biomes! Caverns or a
           curated foreign biome; UrbanRuins = an Ancient urban ruins facility. -->
      <li>AB_CavernCarve</li>
      <li>AB_UrbanRuins</li>
    </genSteps>
  </MapGeneratorDef>

  <MapGeneratorDef>
    <defName>AB_Sky</defName>
    <label>sky level</label>
    <ignoreAreaRevealedLetter>true</ignoreAreaRevealedLetter>
    <disableCallAid>true</disableCallAid>
    <pocketMapProperties>
      <biome>AB_OpenSky</biome>
      <temperature>10</temperature>
      <!-- Explicit (vanilla default): the level dies with the surface map, no orphans. -->
      <destroyOnParentMapAbandoned>true</destroyOnParentMapAbandoned>
    </pocketMapProperties>
    <genSteps>
      <li>AB_SkyTerrain</li>
      <!-- Mountain rivers: projects the ground map's river across the mass top
           and places waterfall lips at the ledges. No-op without a tunneling
           river or with the setting off. -->
      <li>AB_SkyRivers</li>
      <!-- Vanilla tile-mutator phases (Core defs): AB_SkyTerrain (order 200)
           adds the rolled landmark mutators to the pocket tile, then these run
           the real workers at 220/500/700/1600 - structures, ticking setup,
           the whole landmark experience on the sky level. -->
      <li>MutatorPostTerrain</li>
      <li>MutatorCriticalStructures</li>
      <li>MutatorNonCriticalStructures</li>
      <li>MutatorFinal</li>
    </genSteps>
  </MapGeneratorDef>

  <GenStepDef>
    <defName>AB_SolidRock</defName>
    <order>200</order>
    <genStep Class="AsAboveSoBelow.GenStep_ABSolidRock" />
  </GenStepDef>

  <GenStepDef>
    <defName>AB_SkyTerrain</defName>
    <order>200</order>
    <genStep Class="AsAboveSoBelow.GenStep_ABSkyTerrain" />
  </GenStepDef>

  <GenStepDef>
    <defName>AB_CavernCarve</defName>
    <order>210</order>
    <genStep Class="AsAboveSoBelow.GenStep_ABCavernCarve" />
  </GenStepDef>

  <GenStepDef>
    <defName>AB_UrbanRuins</defName>
    <order>215</order>
    <genStep Class="AsAboveSoBelow.GenStep_ABUrbanRuins" />
  </GenStepDef>

</Defs>

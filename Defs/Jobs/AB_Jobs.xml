<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <JobDef>
    <defName>AB_UseStairs</defName>
    <driverClass>AsAboveSoBelow.JobDriver_UseStairs</driverClass>
    <reportString>using stairs.</reportString>
  </JobDef>

  <JobDef>
    <defName>AB_TakeToPenAcrossLevels</defName>
    <driverClass>AsAboveSoBelow.JobDriver_ABTakeToPenAcrossLevels</driverClass>
    <reportString>leading TargetA to a pen on another level.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <playerInterruptible>true</playerInterruptible>
  </JobDef>

  <JobDef>
    <defName>AB_CrossLevelAttack</defName>
    <driverClass>AsAboveSoBelow.JobDriver_ABCrossLevelAttack</driverClass>
    <reportString>attacking across levels.</reportString>
    <playerInterruptible>true</playerInterruptible>
    <alwaysShowWeapon>true</alwaysShowWeapon>
    <suspendable>false</suspendable>
  </JobDef>

  <JobDef>
    <defName>AB_HaulAcrossLevels</defName>
    <driverClass>AsAboveSoBelow.JobDriver_HaulAcrossLevels</driverClass>
    <reportString>hauling TargetA to another level.</reportString>
    <playerInterruptible>true</playerInterruptible>
  </JobDef>

  <JobDef>
    <defName>AB_HaulChainAcrossLevels</defName>
    <driverClass>AsAboveSoBelow.JobDriver_HaulAcrossLevels</driverClass>
    <reportString>hauling TargetA across levels.</reportString>
    <playerInterruptible>true</playerInterruptible>
  </JobDef>

  <JobDef>
    <defName>AB_BulkHaulAcrossLevels</defName>
    <driverClass>AsAboveSoBelow.JobDriver_ABBulkHaulAcrossLevels</driverClass>
    <reportString>hauling things to another level.</reportString>
    <playerInterruptible>true</playerInterruptible>
  </JobDef>

  <JobDef>
    <defName>AB_RescueAcrossLevels</defName>
    <driverClass>AsAboveSoBelow.JobDriver_ABTakePawnAcrossLevels</driverClass>
    <reportString>rescuing TargetA to another level.</reportString>
    <playerInterruptible>true</playerInterruptible>
  </JobDef>

  <JobDef>
    <defName>AB_CaptureAcrossLevels</defName>
    <driverClass>AsAboveSoBelow.JobDriver_ABTakePawnAcrossLevels</driverClass>
    <reportString>capturing TargetA to another level.</reportString>
    <playerInterruptible>true</playerInterruptible>
  </JobDef>

  <JobDef>
    <defName>AB_TakePrisonerAcrossLevels</defName>
    <driverClass>AsAboveSoBelow.JobDriver_ABTakePawnAcrossLevels</driverClass>
    <reportString>taking prisoner TargetA to another level.</reportString>
    <playerInterruptible>true</playerInterruptible>
  </JobDef>

  <JobDef>
    <defName>AB_TakeEntityAcrossLevels</defName>
    <driverClass>AsAboveSoBelow.JobDriver_ABTakePawnAcrossLevels</driverClass>
    <reportString>carrying TargetA toward containment on another level.</reportString>
    <playerInterruptible>true</playerInterruptible>
  </JobDef>

</Defs>

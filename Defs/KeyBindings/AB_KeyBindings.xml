<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <KeyBindingCategoryDef>
    <defName>AB_Keys</defName>
    <label>As above, So below</label>
    <description>Key bindings for As above, So below.</description>
  </KeyBindingCategoryDef>

  <KeyBindingDef>
    <defName>AB_ViewLevelUp</defName>
    <category>AB_Keys</category>
    <label>view level above</label>
    <defaultKeyCodeA>PageUp</defaultKeyCodeA>
  </KeyBindingDef>

  <KeyBindingDef>
    <defName>AB_ViewLevelDown</defName>
    <category>AB_Keys</category>
    <label>view level below</label>
    <defaultKeyCodeA>PageDown</defaultKeyCodeA>
  </KeyBindingDef>

  <!-- AB_CameraLevelLock removed with V1: the camera lock existed because pocket levels
       were separate Maps and switching one could yank the view. V2's camera is clamped to
       the current band by ABBandView, so there is nothing to lock. -->

</Defs>

<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <BiomeDef ParentName="Biome_Underground">
    <defName>AB_Underground</defName>
    <!-- THE BLACK-BASEMENT FIX (live test 2026-07-24): without this, the
         basement used standard sky lighting, and the lighting overlay's
         thick-roof darkness rendered regenerated sections pitch black - the
         overlay only regenerates on glow/roof changes, so the first skylight
         shaft (or any lamp) appeared to "break" basement rendering when it
         merely triggered the regen. disableSkyLighting is the engine's
         underground mode (SkyManager zeroes the LightOverlay darkness
         channel): unlit areas render dim-neutral instead of void black, and
         lamp and skylight glow pools show exactly like vanilla's underground
         maps. The vanilla Biome_Underground parent does NOT carry it. -->
    <disableSkyLighting>true</disableSkyLighting>
    <label>deep underground</label>
    <description>Solid rock beneath the surface, untouched by sun or wind.</description>
    <plantDensity>0</plantDensity>
    <maxFishPopulation>0</maxFishPopulation>
  </BiomeDef>

  <BiomeDef>
    <defName>AB_OpenSky</defName>
    <label>open sky</label>
    <description>The open air above the colony.</description>
    <generatesNaturally>false</generatesNaturally>
    <animalDensity>0</animalDensity>
    <!-- Modest density + a hardy highland mix so plateau vegetation regrows
         naturally. Wild spawning is per-cell fertility-gated, so open air and
         rooftops stay bare; only plateau soil/gravel (and player soil) qualify. -->
    <plantDensity>0.35</plantDensity>
    <!-- Dictionary-style records: <DefName>commonality</DefName>. The li-record
         form belongs to diseases/terrainsByFertility, NOT wildPlants; using it
         here aborts the whole file's def load (learned run #40). -->
    <wildPlants>
      <Plant_Grass>6</Plant_Grass>
      <Plant_TallGrass>1.2</Plant_TallGrass>
      <Plant_Bush>1</Plant_Bush>
      <Plant_Brambles>0.6</Plant_Brambles>
      <Plant_Dandelion>0.5</Plant_Dandelion>
      <Plant_TreePine>0.35</Plant_TreePine>
      <Plant_TreeBirch>0.25</Plant_TreeBirch>
      <Plant_TreeOak>0.2</Plant_TreeOak>
    </wildPlants>
    <wildAnimalsCanWanderInto>false</wildAnimalsCanWanderInto>
    <diseaseMtbDays>120</diseaseMtbDays>
    <baseWeatherCommonalities>
      <Clear>1</Clear>
    </baseWeatherCommonalities>
  </BiomeDef>

</Defs>

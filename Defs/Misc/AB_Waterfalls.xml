<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Waterfall lip: the last river cell before the drop on a sky-level
       watercourse. Foam and spray drawn by the thing class; sound is a
       pitched-down rain loop, one voice per contiguous fall. -->
  <ThingDef>
    <defName>AB_Waterfall</defName>
    <thingClass>AsAboveSoBelow.Thing_ABWaterfall</thingClass>
    <label>waterfall</label>
    <description>The river pours off the mountain's edge here and drops a full level in white water. The roar carries.</description>
    <category>Building</category>
    <tickerType>Normal</tickerType>
    <drawerType>RealtimeOnly</drawerType>
    <graphicData>
      <texPath>Things/AB_Invisible</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <passability>Standable</passability>
    <useHitPoints>false</useHitPoints>
    <selectable>true</selectable>
    <neverMultiSelect>true</neverMultiSelect>
    <rotatable>false</rotatable>
    <scatterableOnMapGen>false</scatterableOnMapGen>
    <drawOffscreen>true</drawOffscreen>
    <building>
      <isEdifice>false</isEdifice>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
      <artificialForMeditationPurposes>false</artificialForMeditationPurposes>
    </building>
  </ThingDef>

  <!-- Invisible marker on the surface river where the water lands: mist and
       rumble at ground level. -->
  <ThingDef>
    <defName>AB_WaterfallBase</defName>
    <thingClass>AsAboveSoBelow.Thing_ABWaterfallBase</thingClass>
    <label>waterfall plunge pool</label>
    <description>Water hammering down from the level above.</description>
    <category>Building</category>
    <tickerType>Normal</tickerType>
    <drawerType>MapMeshOnly</drawerType>
    <graphicData>
      <texPath>Things/AB_Invisible</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>Standable</passability>
    <useHitPoints>false</useHitPoints>
    <selectable>false</selectable>
    <neverMultiSelect>true</neverMultiSelect>
    <rotatable>false</rotatable>
    <scatterableOnMapGen>false</scatterableOnMapGen>
    <building>
      <isEdifice>false</isEdifice>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
      <artificialForMeditationPurposes>false</artificialForMeditationPurposes>
    </building>
  </ThingDef>

  <!-- Spatial white-water loop: the vanilla rain clip, pitched down, with
       real distance attenuation (the stock Ambient_Rain def is onCamera and
       cannot attenuate). Clip path resolves from Core. -->
  <SoundDef>
    <defName>AB_WaterfallLoop</defName>
    <sustain>True</sustain>
    <context>MapOnly</context>
    <maxSimultaneous>3</maxSimultaneous>
    <priorityMode>PrioritizeNearest</priorityMode>
    <subSounds>
      <li>
        <muteWhenPaused>True</muteWhenPaused>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>Ambience/Amb_Raining2_Loop</clipPath>
          </li>
        </grains>
        <volumeRange>16~16</volumeRange>
        <pitchRange>0.70~0.78</pitchRange>
        <distRange>9~46</distRange>
      </li>
    </subSounds>
  </SoundDef>

  <GenStepDef>
    <defName>AB_SkyRivers</defName>
    <order>205</order>
    <genStep Class="AsAboveSoBelow.GenStep_ABSkyRivers" />
  </GenStepDef>

</Defs>

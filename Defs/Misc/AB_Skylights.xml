<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Invisible one-cell daylight source under a skylight pane. A stock
       CompGlower does the lighting; the thing class gates it on the sun and
       the pane chain (IThingGlower) and re-checks on rare tick. Overlight
       near the pane gives plants true full-sun growth (user directive). -->
  <ThingDef>
    <defName>AB_SkylightShaft</defName>
    <thingClass>AsAboveSoBelow.Thing_ABSkylightShaft</thingClass>
    <label>skylight shaft</label>
    <description>Daylight falling through the skylight overhead.</description>
    <category>Building</category>
    <tickerType>Rare</tickerType>
    <drawerType>MapMeshOnly</drawerType>
    <graphicData>
      <texPath>Things/AB_Invisible</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>Standable</passability>
    <useHitPoints>false</useHitPoints>
    <selectable>false</selectable>
    <neverMultiSelect>true</neverMultiSelect>
    <rotatable>false</rotatable>
    <scatterableOnMapGen>false</scatterableOnMapGen>
    <building>
      <isEdifice>false</isEdifice>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
      <artificialForMeditationPurposes>false</artificialForMeditationPurposes>
    </building>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>3.5</glowRadius>
        <overlightRadius>2.1</overlightRadius>
        <glowColor>(310,310,290,0)</glowColor>
      </li>
    </comps>
  </ThingDef>

</Defs>

<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase" Name="AB_VerticalLinkBase" Abstract="True">
    <thingClass>AsAboveSoBelow.Building_ABUtilityLink</thingClass>
    <!-- Conduits layer: risers draw like the utility lines they extend and
         disappear into the run instead of reading as furniture. -->
    <altitudeLayer>Conduits</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>10</pathCost>
    <fillPercent>0.15</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <!-- Immortal, same as stairs: see AB_StairsBase. -->
    <useHitPoints>false</useHitPoints>
    <statBases>
      <Flammability>0</Flammability>
      <Mass>8</Mass>
    </statBases>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <placeWorkers>
      <li>AsAboveSoBelow.PlaceWorker_ABStairs</li>
    </placeWorkers>
  </ThingDef>

  <ThingDef ParentName="AB_VerticalLinkBase" Name="AB_VerticalConduitBase" Abstract="True">
    <designationCategory>Power</designationCategory>
    <!-- Invisible riser: draws as a plain vanilla conduit segment and links
         into adjacent conduit runs, so the shaft reads as just another
         stretch of cable. Vanilla atlas + menu icon; no custom art. -->
    <graphicData>
      <texPath>Things/Building/Linked/PowerConduit_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <linkType>Transmitter</linkType>
      <linkFlags>
        <li>PowerConduit</li>
      </linkFlags>
    </graphicData>
    <uiIconPath>Things/Building/Linked/PowerConduit_MenuIcon</uiIconPath>
    <uiIconScale>0.7</uiIconScale>
    <costList>
      <Steel>20</Steel>
    </costList>
    <statBases>
      <WorkToBuild>1000</WorkToBuild>
    </statBases>
    <!-- Normal ticker: the direct grid link recomputes flow in CompTick. -->
    <tickerType>Normal</tickerType>
    <researchPrerequisites>
      <li>Electricity</li>
    </researchPrerequisites>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>AsAboveSoBelow.CompABGridLink</compClass>
        <basePowerConsumption>0</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="AB_VerticalConduitBase">
    <defName>AB_VerticalConduitDown</defName>
    <label>vertical conduit (down)</label>
    <description>A sealed cable shaft carrying power to the level below. Connects the power networks touching it on both levels; nothing can climb through it, and it does not leak temperature. Completing it opens the basement level below if none exists yet. Uninstalling either end removes both.</description>
    <modExtensions>
      <li Class="AsAboveSoBelow.ABStairsExtension">
        <deltaLevel>-1</deltaLevel>
        <counterpartDef>AB_VerticalConduitUp</counterpartDef>
        <utilityOnly>true</utilityOnly>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="AB_VerticalConduitBase">
    <defName>AB_VerticalConduitUp</defName>
    <label>vertical conduit (up)</label>
    <description>A sealed cable shaft carrying power to the level above. Connects the power networks touching it on both levels; nothing can climb through it, and it does not leak temperature. Completing it opens the sky level above if none exists yet. Uninstalling either end removes both.</description>
    <modExtensions>
      <li Class="AsAboveSoBelow.ABStairsExtension">
        <deltaLevel>1</deltaLevel>
        <counterpartDef>AB_VerticalConduitDown</counterpartDef>
        <utilityOnly>true</utilityOnly>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>

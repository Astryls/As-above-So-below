<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase" Name="AB_StairsBase" Abstract="True">
    <thingClass>AsAboveSoBelow.Building_ABStairs</thingClass>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>42</pathCost>
    <fillPercent>0.40</fillPercent>
    <!-- Rotatable: the flight faces the direction pawns descend/ascend.
         Counterpart spawning copies Rotation, so the pair stays aligned. -->
    <rotatable>true</rotatable>
    <size>(1,1)</size>
    <designationCategory>Structure</designationCategory>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <!-- Immortal: raid AI trashes the only player buildings on a pocket level
         instead of using them, severing the column. No hit points means no
         damage, no fire, no target; removal is the gizmo/deconstruct path. -->
    <useHitPoints>false</useHitPoints>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>75</costStuffCount>
    <statBases>
      <WorkToBuild>3200</WorkToBuild>
      <Flammability>0</Flammability>
      <Mass>35</Mass>
    </statBases>
    <!-- Stairs carry pawns only; utilities cross through the dedicated
         vertical links, so stairs need no ticker at all. -->
    <tickerType>Never</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <placeWorkers>
      <li>AsAboveSoBelow.PlaceWorker_ABStairs</li>
    </placeWorkers>
  </ThingDef>

  <ThingDef ParentName="AB_StairsBase">
    <defName>AB_StairsDown</defName>
    <label>stairs down</label>
    <description>A stairwell leading down. Completing it opens the basement level below and creates a matching stairwell there. The basement starts as solid rock, so bring miners.</description>
    <graphicData>
      <texPath>Things/Building/AB_StairsDown</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <uiIconPath>Things/Building/AB_StairsDown</uiIconPath>
    <modExtensions>
      <li Class="AsAboveSoBelow.ABStairsExtension">
        <deltaLevel>-1</deltaLevel>
        <counterpartDef>AB_StairsUp</counterpartDef>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="AB_StairsBase" Name="AB_GrandStairsBase" Abstract="True">
    <size>(2,2)</size>
    <fillPercent>0.50</fillPercent>
    <costStuffCount>300</costStuffCount>
    <statBases>
      <WorkToBuild>12000</WorkToBuild>
      <Mass>160</Mass>
    </statBases>
    <comps>
      <li>
        <compClass>CompQuality</compClass>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="AB_GrandStairsBase">
    <defName>AB_GrandStairsDown</defName>
    <label>grand staircase down</label>
    <description>A wide, stately staircase leading down. Faster to climb than normal stairs, and better craftsmanship makes it faster still. Completing it opens the basement level below and creates a matching staircase there.</description>
    <graphicData>
      <texPath>Things/Building/AB_GrandStairsDown</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <uiIconPath>Things/Building/AB_GrandStairsDown</uiIconPath>
    <modExtensions>
      <li Class="AsAboveSoBelow.ABStairsExtension">
        <deltaLevel>-1</deltaLevel>
        <counterpartDef>AB_GrandStairsUp</counterpartDef>
        <climbFactor>0.6</climbFactor>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="AB_GrandStairsBase">
    <defName>AB_GrandStairsUp</defName>
    <label>grand staircase up</label>
    <description>A wide, stately staircase leading up. Faster to climb than normal stairs, and better craftsmanship makes it faster still. Completing it opens the sky level above and creates a matching staircase there.</description>
    <graphicData>
      <texPath>Things/Building/AB_GrandStairsUp</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <uiIconPath>Things/Building/AB_GrandStairsUp</uiIconPath>
    <modExtensions>
      <li Class="AsAboveSoBelow.ABStairsExtension">
        <deltaLevel>1</deltaLevel>
        <counterpartDef>AB_GrandStairsDown</counterpartDef>
        <climbFactor>0.6</climbFactor>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="AB_StairsBase">
    <defName>AB_Elevator</defName>
    <label>elevator</label>
    <description>An elevator car. Use its controls to extend the shaft up or down, opening that level and placing a linked car there. A car on the ground level can hold links in both directions, letting pawns ride straight between the sky level and the basement in one trip. Rides are much faster than stairs, and the shaft carries a power link.</description>
    <thingClass>AsAboveSoBelow.Building_ABElevator</thingClass>
    <!-- The car is a symmetric cage; rotation is meaningless. Overrides the
         rotatable stairs base. -->
    <rotatable>false</rotatable>
    <stuffCategories Inherit="False">
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>200</costStuffCount>
    <statBases>
      <WorkToBuild>9000</WorkToBuild>
      <Flammability>0</Flammability>
      <Mass>70</Mass>
    </statBases>
    <graphicData>
      <texPath>Things/Building/AB_Elevator_AB_Elevator</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <uiIconPath>Things/Building/AB_Elevator</uiIconPath>
    <modExtensions>
      <li Class="AsAboveSoBelow.ABStairsExtension">
        <deltaLevel>0</deltaLevel>
        <counterpartDef>AB_Elevator</counterpartDef>
        <climbFactor>0.35</climbFactor>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="BuildingBase" Name="AB_LadderBase" Abstract="True">
    <thingClass>AsAboveSoBelow.Building_ABStairs</thingClass>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.20</fillPercent>
    <!-- Rotatable: the ladder leans against the wall on its facing edge. -->
    <rotatable>true</rotatable>
    <size>(1,1)</size>
    <designationCategory>Structure</designationCategory>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <!-- Immortal, same as stairs: see AB_StairsBase. -->
    <useHitPoints>false</useHitPoints>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>25</costStuffCount>
    <statBases>
      <WorkToBuild>800</WorkToBuild>
      <Flammability>0</Flammability>
      <Mass>10</Mass>
    </statBases>
    <!-- No power bridge comp: ladders do not carry utility lines. -->
    <tickerType>Never</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <placeWorkers>
      <li>AsAboveSoBelow.PlaceWorker_ABStairs</li>
    </placeWorkers>
  </ThingDef>

  <ThingDef ParentName="AB_LadderBase">
    <defName>AB_LadderDown</defName>
    <label>ladder down</label>
    <description>A cheap ladder leading down. Slower to climb than stairs and cannot carry a power link. Completing it opens the basement level below and creates a matching ladder there.</description>
    <graphicData>
      <texPath>Things/Building/AB_LadderDown</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
      <drawOffsetNorth>(0,0,0.33)</drawOffsetNorth>
      <drawOffsetEast>(0.33,0,0)</drawOffsetEast>
      <drawOffsetSouth>(0,0,-0.33)</drawOffsetSouth>
      <drawOffsetWest>(-0.33,0,0)</drawOffsetWest>
    </graphicData>
    <uiIconPath>Things/Building/AB_LadderDown</uiIconPath>
    <modExtensions>
      <li Class="AsAboveSoBelow.ABStairsExtension">
        <deltaLevel>-1</deltaLevel>
        <counterpartDef>AB_LadderUp</counterpartDef>
        <climbFactor>1.6</climbFactor>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="AB_LadderBase">
    <defName>AB_LadderUp</defName>
    <label>ladder up</label>
    <description>A cheap ladder leading up. Slower to climb than stairs and cannot carry a power link. Completing it opens the sky level above and creates a matching ladder there.</description>
    <graphicData>
      <texPath>Things/Building/AB_LadderUp</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
      <drawOffsetNorth>(0,0,0.33)</drawOffsetNorth>
      <drawOffsetEast>(0.33,0,0)</drawOffsetEast>
      <drawOffsetSouth>(0,0,-0.33)</drawOffsetSouth>
      <drawOffsetWest>(-0.33,0,0)</drawOffsetWest>
    </graphicData>
    <uiIconPath>Things/Building/AB_LadderUp</uiIconPath>
    <modExtensions>
      <li Class="AsAboveSoBelow.ABStairsExtension">
        <deltaLevel>1</deltaLevel>
        <counterpartDef>AB_LadderDown</counterpartDef>
        <climbFactor>1.6</climbFactor>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="AB_StairsBase">
    <defName>AB_StairsUp</defName>
    <label>stairs up</label>
    <description>A stairwell leading up. Completing it opens the sky level above and creates a matching stairwell there. Up there you can only walk and build above roofed parts of your base.</description>
    <graphicData>
      <texPath>Things/Building/AB_StairsUp</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <uiIconPath>Things/Building/AB_StairsUp</uiIconPath>
    <modExtensions>
      <li Class="AsAboveSoBelow.ABStairsExtension">
        <deltaLevel>1</deltaLevel>
        <counterpartDef>AB_StairsDown</counterpartDef>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>

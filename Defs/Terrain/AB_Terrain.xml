<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <TerrainDef>
    <defName>AB_OpenAir</defName>
    <label>open air</label>
    <description>Nothing here but a long drop to the level below.</description>
    <texturePath>Terrain/AB_OpenAir</texturePath>
    <dontRender>true</dontRender>
    <edgeType>Hard</edgeType>
    <renderPrecedence>15</renderPrecedence>
    <layerable>false</layerable>
    <passability>Impassable</passability>
    <avoidWander>true</avoidWander>
    <fertility>0</fertility>
  </TerrainDef>

  <TerrainDef>
    <defName>AB_RoofSurface</defName>
    <label>rooftop</label>
    <description>The tiled steel top side of a roof on the level below. Sturdy enough to walk on and build on.</description>
    <texturePath>Terrain/Surfaces/GenericFloorTile</texturePath>
    <color>(0.32, 0.32, 0.32)</color>
    <edgeType>Hard</edgeType>
    <renderPrecedence>230</renderPrecedence>
    <layerable>false</layerable>
    <passability>Standable</passability>
    <pathCost>1</pathCost>
    <fertility>0</fertility>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
    </affordances>
  </TerrainDef>

  <!-- The top of a wall on the level below: you may BUILD on it (so walls stack into a
       tower) but you may not WALK on it. Impassable + full affordances is exactly how
       vanilla treats deep water under a bridge - construction only needs the builder to
       reach an ADJACENT cell, not to stand on the target - so the two properties are not
       in conflict.
       Kept distinct from AB_RoofSurface on purpose: a roof is a floor you can walk out
       onto, a wall top is a ledge you can only build on. -->
  <TerrainDef>
    <defName>AB_WallTop</defName>
    <label>wall top</label>
    <description>The narrow top of a wall on the level below. Too narrow to walk along, but solid enough to build on - stack another wall here to raise the structure.</description>
    <!-- dontRender, exactly like AB_OpenAir, and for the same reason: the top of a wall
         seen from the level above IS the wall, so this cell must show the building below
         rather than paint over it. Two earlier attempts both painted something here and
         both looked broken - Terrain/AB_MountainTop (near-black, because the mountain-cap
         layer shades it) gave an opaque black slab, and a tinted floor tile gave a flat
         grey square where a wooden wall should be. The terrain exists purely to carry
         passability and affordance; ABBands.ShowsBelow lets the see-below renderer draw
         straight through it. -->
    <texturePath>Terrain/AB_OpenAir</texturePath>
    <dontRender>true</dontRender>
    <edgeType>Hard</edgeType>
    <renderPrecedence>232</renderPrecedence>
    <layerable>false</layerable>
    <passability>Impassable</passability>
    <fertility>0</fertility>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
    </affordances>
  </TerrainDef>

  <TerrainDef>
    <defName>AB_MountainTop</defName>
    <label>mountain top</label>
    <description>The unbroken top of the mountain mass below. Bare, dark stone; nothing grows up here, but floors can be laid over it.</description>
    <texturePath>Terrain/AB_MountainTop</texturePath>
    <edgeType>Hard</edgeType>
    <renderPrecedence>231</renderPrecedence>
    <layerable>false</layerable>
    <passability>Standable</passability>
    <pathCost>2</pathCost>
    <fertility>0</fertility>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
    </affordances>
  </TerrainDef>

</Defs>

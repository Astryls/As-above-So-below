<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- The glass pane slab. dontRender like AB_OpenAir: the renderer draws the
       level below through this cell and adds its own glass tint and frame in
       the mask pass, so no terrain shader alpha gamble. Sealed: standable,
       normal floor affordances minus heavy, no light/rain/temperature holes -
       the light arrives via AB_SkylightShaft glowers on the level below. -->
  <TerrainDef>
    <defName>AB_Skylight</defName>
    <label>skylight</label>
    <description>A slab of tough laminated glass set flush into the deck. You can see the level below through it, and daylight pours through to whatever lies beneath. Walkable, sealed against rain and cold, far too tough to shoot through.</description>
    <texturePath>Terrain/AB_OpenAir</texturePath>
    <dontRender>true</dontRender>
    <edgeType>Hard</edgeType>
    <renderPrecedence>232</renderPrecedence>
    <layerable>false</layerable>
    <passability>Standable</passability>
    <pathCost>1</pathCost>
    <fertility>0</fertility>
    <statBases>
      <Beauty>2</Beauty>
    </statBases>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
    </affordances>
  </TerrainDef>

</Defs>

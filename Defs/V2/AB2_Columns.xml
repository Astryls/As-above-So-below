<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    TYPED UTILITY COLUMNS (§62). Four buildables replace the thirty riser defs.

    ⚠ THE COLUMN IS THE ONLY VISIBLE PIECE. It stands on its own level; the cell one Slot
    up receives an INVISIBLE generated carrier (see ABColumnNetworks), never a building,
    never a blocker. Modelled on vanilla's Column: holdsRoof is what makes ABSkySync
    resolve the cell above as buildable (AB_WallTop unroofed, walkable AB_RoofSurface once
    roofed around it), which is the whole "the tile above is the connector" design.

    ⚠ drawSize IS NOT DECOR. The art ships on a 1200x896 canvas with the column occupying
    a centered vertical band; drawSize x must stay 1.34 times y or the sprite squashes.
    (1.61, 1.2) plus the +0.18 z offset gives vanilla Column's tall presence.

    ⚠ NO GAS COLUMN BY DESIGN. Fluids and gases share the Pipe column; the classifier
    (ABColumnNetworks.Classify) buckets every detected network into exactly one of the
    four types here, and an ABColumnAdapterDef <columnType> can override a wrong guess.
  -->
  <ThingDef Name="AB_ColumnBase" ParentName="BuildingBase" Abstract="True">
    <thingClass>AsAboveSoBelow.Building_ABColumn</thingClass>
    <category>Building</category>
    <designationCategory>Structure</designationCategory>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.25</fillPercent>
    <pathCost>0</pathCost>
    <uiIconScale>1.2</uiIconScale>
    <holdsRoof>true</holdsRoof>
    <canOverlapZones>false</canOverlapZones>
    <rotatable>false</rotatable>
    <fertility>0</fertility>
    <specialDisplayRadius>6.9</specialDisplayRadius>
    <constructEffect>ConstructMetal</constructEffect>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>2800</WorkToBuild>
      <Mass>20</Mass>
      <Flammability>0.5</Flammability>
      <Beauty>0</Beauty>
    </statBases>
    <costList>
      <Steel>60</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <!-- ONE FREE-STANDING PROJECT, AND THAT IS THE WHOLE GATE (supersedes §75.f).
         §75.f removed researchPrerequisites outright because gating a column behind
         Electricity + Machining left a fresh banded colony unable to join its levels'
         utilities until mid game. AB2_TransferColumns keeps that concern intact: it has
         NO prerequisites of its own, so the only thing between a new colony and its
         columns is 1200 of bench time, reachable from turn one.
         The PER-NETWORK connect toggles still respect each host mod's own research
         (Building_ABColumn.GetGizmos -> AB2_ColumnNeedsResearch), so a network you
         have not unlocked still cannot be carried even with this finished. -->
    <researchPrerequisites>
      <li>AB2_TransferColumns</li>
    </researchPrerequisites>
    <building>
      <isInert>true</isInert>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.61,1.2)</drawSize>
      <drawOffset>(0,0,0.18)</drawOffset>
      <shadowData>
        <volume>(0.35,0.5,0.35)</volume>
        <offset>(0,0,-0.23)</offset>
      </shadowData>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="AB_ColumnBase">
    <defName>AB_ColumnPower</defName>
    <label>power column</label>
    <description>A reinforced service column carrying electrical conduit up through the ceiling. Power grids on this level and the level above pool into one, and each connection can be switched off at the column. Sturdy enough to hold a roof.</description>
    <uiOrder>2070</uiOrder>
    <graphicData>
      <texPath>Things/Building/Columns/AB_ColumnPower</texPath>
    </graphicData>
    <modExtensions>
      <li Class="AsAboveSoBelow.ABColumnTypeExt">
        <columnType>Power</columnType>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="AB_ColumnBase">
    <defName>AB_ColumnPipe</defName>
    <label>pipe column</label>
    <description>A reinforced service column carrying sealed piping up through the ceiling. Every liquid and gas network it recognizes can be connected to the level above or shut off individually at the column. Sturdy enough to hold a roof.</description>
    <uiOrder>2071</uiOrder>
    <graphicData>
      <texPath>Things/Building/Columns/AB_ColumnPipe</texPath>
    </graphicData>
    <modExtensions>
      <li Class="AsAboveSoBelow.ABColumnTypeExt">
        <columnType>Pipe</columnType>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="AB_ColumnBase">
    <defName>AB_ColumnClimate</defName>
    <label>climate column</label>
    <description>A reinforced service column carrying air ducting up through the ceiling. Ventilation and thermal networks can be connected to the level above or shut off individually at the column. Sturdy enough to hold a roof.</description>
    <uiOrder>2072</uiOrder>
    <graphicData>
      <texPath>Things/Building/Columns/AB_ColumnClimate</texPath>
    </graphicData>
    <modExtensions>
      <li Class="AsAboveSoBelow.ABColumnTypeExt">
        <columnType>Climate</columnType>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="AB_ColumnBase">
    <defName>AB_ColumnData</defName>
    <label>data column</label>
    <description>A reinforced service column carrying signal and logistics lines up through the ceiling. Data networks can be connected to the level above or shut off individually at the column. Sturdy enough to hold a roof.</description>
    <uiOrder>2073</uiOrder>
    <graphicData>
      <texPath>Things/Building/Columns/AB_ColumnData</texPath>
    </graphicData>
    <modExtensions>
      <li Class="AsAboveSoBelow.ABColumnTypeExt">
        <columnType>Data</columnType>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- ======================= wall risers (§75) ======================= -->

  <!-- The four columns in wall-lamp form factor. Same thingClass, same carriers, same
       gizmos, same up-cell rule: Building_ABColumn is Position-driven throughout, so a
       riser IS a column that happens to hang on a wall.

       Attachment mechanics are vanilla WallLamp's: Position is the walkable room-side
       cell, ROTATION FACES THE WALL (Placeworker_AttachedToWall checks
       loc + CardinalDirections[rot]), the sprite is pushed 0.9 onto the wall cell by
       the per-rotation drawOffsets, and the fixture is destroyed with its wall.
       isEdifice false keeps the cell open for furniture; Standable keeps it walkable -
       the whole point of the form factor. The host wall must have
       supportsWallAttachments (vanilla walls do; some mod walls will not - that is the
       same limitation wall lamps live with).

       ⚠ NO holdsRoof, TWICE OVER: RoofCollapseUtility walks the EDIFICE grid, so
       holdsRoof on a non-edifice would be a lie nothing reads; and a 35-steel fixture
       must not become a cheap roof prop that undercuts the column. EnsureRoof still
       works unchanged: the riser lays RoofConstructed on its own cell, and the HOST
       WALL is the adjacent edifice support that makes that roof legal. The §45 up-cell
       rule then resolves the cell above as AB_RoofSurface exactly as it does over a
       roofed column.

       ⚠ CARRIER ART IS SUPPRESSED UNDER RISERS, same as under columns (§62.M). The
       first field test shipped the opposite: with the riser sprite hanging on the wall
       cell and the carrier at Position (the room-side cell in front of it), the
       visible stub read as a stray conduit placed one tile out from the wall. The
       riser ART carries the connection story (conduit strip up the plate); the
       network overlays still print the carrier, which is where connectivity is read.
       §75.b extended the rule to the riser's UP-CELL carrier, and §75.e finished the
       job: after the compat run the user revoked §62.J's visible column tops too, so
       NO carrier is drawn in normal view on any level, under either connector form.
       The fixture art carries the connection story; the network overlays still print
       every carrier, which is where connectivity is read.

       ⚠ KNOWN MICRO-EDGE: two risers may share a corner cell on two different walls.
       EnsureRoof runs only in SpawnSetup, so removing the roof-laying one degrades the
       up-cell until vanilla auto-roof or the player re-covers it. Accepted. -->

  <ThingDef Name="AB_WallRiserBase" ParentName="BuildingBase" Abstract="True">
    <thingClass>AsAboveSoBelow.Building_ABColumn</thingClass>
    <category>Building</category>
    <designationCategory>Structure</designationCategory>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <fillPercent>0.2</fillPercent>
    <rotatable>true</rotatable>
    <terrainAffordanceNeeded IsNull="True" />
    <constructEffect>ConstructMetal</constructEffect>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>1800</WorkToBuild>
      <Mass>8</Mass>
      <Flammability>0.5</Flammability>
      <Beauty>0</Beauty>
    </statBases>
    <costList>
      <Steel>35</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <!-- Same project as the column: a riser IS a column in a different form factor, and
         splitting them would let a player unlock the awkward one and not the other. -->
    <researchPrerequisites>
      <li>AB2_TransferColumns</li>
    </researchPrerequisites>
    <building>
      <isInert>true</isInert>
      <isEdifice>false</isEdifice>
      <isAttachment>true</isAttachment>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <placeWorkers>
      <li>Placeworker_AttachedToWall</li>
    </placeWorkers>
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
      <drawOffsetNorth>(0,0,0.9)</drawOffsetNorth>
      <drawOffsetSouth>(0,0,-0.9)</drawOffsetSouth>
      <drawOffsetWest>(-0.9,0,0)</drawOffsetWest>
      <drawOffsetEast>(0.9,0,0)</drawOffsetEast>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="AB_WallRiserBase">
    <defName>AB_WallRiserPower</defName>
    <label>power wall riser</label>
    <description>A wall-mounted riser carrying electrical conduit up through the ceiling. Bolted to a wall rather than standing on the floor, so the cell beneath it stays free to walk and build on. Power grids on this level and the level above pool into one, and each connection can be switched off at the riser. Torn down with its wall, and too light to hold a roof.</description>
    <uiOrder>2080</uiOrder>
    <graphicData>
      <texPath>Things/Building/Risers/AB_WallRiserPower</texPath>
    </graphicData>
    <uiIconPath>Things/Building/Risers/AB_WallRiserPower_north</uiIconPath>
    <modExtensions>
      <li Class="AsAboveSoBelow.ABColumnTypeExt">
        <columnType>Power</columnType>
      </li>
    </modExtensions>
  </ThingDef>


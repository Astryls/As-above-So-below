<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- V2 stairwells. Both inherit DoorBase so their cell becomes a
       RegionType.Portal region - the mechanism that lets ABWormhole join two
       bands without merging their rooms or temperatures.
       Art reuses vanilla door textures for now; the MORTON stair pack can be
       grafted on once V2's geometry is settled. -->

  <ThingDef ParentName="DoorBase" Name="AB2_StairsBase" Abstract="True">
    <thingClass>AsAboveSoBelow.Building_ABStairs2</thingClass>
    <designationCategory>Structure</designationCategory>
    <costStuffCount>40</costStuffCount>
    <statBases>
      <WorkToBuild>1200</WorkToBuild>
      <MaxHitPoints>240</MaxHitPoints>
    </statBases>
    <graphicData>
      <texPath>Things/Building/Door/DoorSimple_Mover</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <uiIconPath>Things/Building/Door/DoorSimple_MenuIcon</uiIconPath>
    <building>
      <isStuffableAirtight>true</isStuffableAirtight>
    </building>
  </ThingDef>

  <ThingDef ParentName="AB2_StairsBase">
    <defName>AB2_StairsDown</defName>
    <label>stairs down</label>
    <description>A shaft descending to the level below. Building it opens the basement level and joins it to this one: colonists haul, work, sleep and fight across the connection exactly as they would across a corridor.</description>
    <modExtensions>
      <li Class="AsAboveSoBelow.ABBandStairsExt">
        <levelDelta>-1</levelDelta>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="AB2_StairsBase">
    <defName>AB2_StairsUp</defName>
    <label>stairs up</label>
    <description>A shaft climbing to the level above. Building it opens the sky level and joins it to this one: colonists haul, work, sleep and fight across the connection exactly as they would across a corridor.</description>
    <modExtensions>
      <li Class="AsAboveSoBelow.ABBandStairsExt">
        <levelDelta>1</levelDelta>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>

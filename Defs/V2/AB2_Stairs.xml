<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- V2 vertical links, using the MORTON art pack (same textures V1 ships).

       All inherit DoorBase so the cell becomes a RegionType.Portal region - the
       mechanism that lets ABWormhole join two bands without merging their rooms
       or temperatures. Several DoorBase defaults have to be overridden, because
       a stairwell is a hole rather than a sliding door:

         drawerType    RealtimeOnly -> MapMeshOnly   (print the graphic like a
                       normal building; also makes stairwells visible in the sky
                       level's see-below view, which RealtimeOnly things are not)
         rotatable     false -> true                 (MORTON art is directional)
         altitudeLayer DoorMoveable -> Building
         blockLight    true -> false                 (a shaft is not a wall)
         fillPercent   1 -> 0.4

       useHitPoints false is inherited behaviour from V1 and deliberate: raiders
       otherwise trash the only player structure on an otherwise empty level and
       sever the column. Removal is via deconstruct. -->

  <ThingDef ParentName="DoorBase" Name="AB2_LinkBase" Abstract="True">
    <thingClass>AsAboveSoBelow.Building_ABStairs2</thingClass>
    <!-- Rejects placements with no CARDINAL approach - a link flush against walls can be
         left reachable only diagonally, and PathUtility.BlocksDiagonalMovement trips on
         unwalkable cells (doors are not special-cased), which is what made pawns stall at
         stairwells.
         Inherit="False" because RimWorld MERGES <li> lists with the parent by default
         (discovered via the wooden elevator: a child stuffCategories list APPENDED to the
         base's). Without it, DoorBase's PlaceWorker_DoorLearnOpeningSpeed plus our
         restated copy made a duplicate. This list is the complete, authoritative set. -->
    <placeWorkers Inherit="False">
      <li>PlaceWorker_DoorLearnOpeningSpeed</li>
      <li>AsAboveSoBelow.PlaceWorker_ABLinkApproach</li>
    </placeWorkers>
    <drawerType>MapMeshOnly</drawerType>
    <rotatable>true</rotatable>
    <defaultPlacingRot>South</defaultPlacingRot>
    <altitudeLayer>Building</altitudeLayer>
    <blockLight>false</blockLight>
    <fillPercent>0.40</fillPercent>
    <useHitPoints>false</useHitPoints>
    <designationCategory>Structure</designationCategory>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <!-- Normal, NOT Never, and the node must STAY EXPLICIT even though it matches
         DoorBase's default. Building_Door.Tick is where vanilla runs
         GenTemperature.EqualizeTemperaturesThroughBuilding, so a non-ticking door's
         portal room keeps whatever temperature heat pushed into it FOREVER - field
         report: a stair end pinned at 716 C after a surface fire, burning every pawn
         that crossed, for tens of thousands of ticks. Independently diagnosed by the
         Workshop fix mod 3788710126 ("AASB - Stair Temperature Fix"), whose
         PatchOperationReplace targets exactly this node: keeping it explicit turns
         that patch into a harmless no-op instead of a red xpath error.
         Ticking CANNOT re-close a link: Building_ABStairs2 overrides AlwaysOpen to
         true, which makes both of vanilla's close paths (the countdown branch and
         CanTryCloseAutomatically) unreachable, and the SpawnSetup openInt latch
         still pins links open from their first tick. -->
    <tickerType>Normal</tickerType>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>75</costStuffCount>
    <statBases>
      <WorkToBuild>3200</WorkToBuild>
      <Flammability>0</Flammability>
      <Mass>35</Mass>
    </statBases>
    <building>
      <!-- DoorBase sets blueprintClass=Blueprint_Door plus a Door_Blueprint texture, so
           every vertical link rendered as a generic door outline while being placed - the
           2x2 staircase art only appeared once the thing was built. Blueprint_ABBuild is
           Blueprint_Build plus the finished stuff tint (a granite staircase plans granite).
           The per-def blueprintGraphicData blocks below are the no-dll fallback only:
           vanilla forces a blue 0.6-alpha wash in C#, and ABBlueprintLook rebuilds every
           AB2 blueprint graphic from the real art at startup. useBlueprintGraphicAsGhost
           does NOT cover door-class defs (GhostGraphicFor's IsDoor branch ignores it and
           used the non-rotating uiIcon); ABGhostGraphicForLinks bypasses that branch. -->
      <blueprintClass>AsAboveSoBelow.Blueprint_ABBuild</blueprintClass>
    </building>
    <useBlueprintGraphicAsGhost>true</useBlueprintGraphicAsGhost>
  </ThingDef>

  <!-- ============================ stairs ============================ -->

  <!-- SIZE MATCHES THE ART.

       These were drawSize (2,2) with no <size>, so a 2x2 staircase sat on a ONE CELL
       footprint. A Building_Door is enterable only from its four cardinal neighbours, so the
       visual overhang covered cells that were solid to the pathfinder: whether a pawn got
       through depended on which side it approached from, which is why the stairs worked
       "sometimes". A real 2x2 footprint gives eight cardinal approach cells instead of four
       and makes the walkable shape match what the player sees. -->
  <ThingDef ParentName="AB2_LinkBase">
    <defName>AB2_StairsDown</defName>
    <label>stairs down</label>
    <description>A stairwell leading down. Completing it opens the basement level below and creates a matching stairwell there. Colonists haul, work, sleep and fight across the connection exactly as they would across a corridor.</description>
    <size>(2,2)</size>
    <graphicData>
      <texPath>Things/Building/AB_StairsDown</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,2)</drawSize>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <building>
      <blueprintGraphicData>
        <texPath>Things/Building/AB_StairsDown</texPath>
        <graphicClass>Graphic_Multi</graphicClass>
        <drawSize>(2,2)</drawSize>
      </blueprintGraphicData>
    </building>
    <uiIconPath>Things/Building/AB_StairsDown</uiIconPath>
    <modExtensions>
      <li Class="AsAboveSoBelow.ABBandStairsExt">
        <levelDelta>-1</levelDelta>
        <counterpartDef>AB2_StairsUp</counterpartDef>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="AB2_LinkBase">
    <defName>AB2_StairsUp</defName>
    <label>stairs up</label>
    <description>A stairwell leading up. Completing it opens the sky level above and creates a matching stairwell there. Colonists haul, work, sleep and fight across the connection exactly as they would across a corridor.</description>
    <size>(2,2)</size>
    <graphicData>
      <texPath>Things/Building/AB_StairsUp</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,2)</drawSize>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <building>
      <blueprintGraphicData>
        <texPath>Things/Building/AB_StairsUp</texPath>
        <graphicClass>Graphic_Multi</graphicClass>
        <drawSize>(2,2)</drawSize>
      </blueprintGraphicData>
    </building>
    <uiIconPath>Things/Building/AB_StairsUp</uiIconPath>
    <modExtensions>
      <li Class="AsAboveSoBelow.ABBandStairsExt">
        <levelDelta>1</levelDelta>
        <counterpartDef>AB2_StairsDown</counterpartDef>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- ========================== elevator =========================== -->

  <!-- ONE shaft, EVERY level. linksAllLevels makes TryEstablish spawn a car on each other
       band of the column and link the whole set as a FULL MESH - the sky and basement cars
       are linked directly, so a sky-to-basement ride is one transit, not a hop through the
       surface. Its counterpartDef is itself: an elevator's far end is an elevator.
       Metallic only and pricier than the grand staircase: it buys reach (three levels from
       one footprint), not speed - transit is instantaneous for every link type. -->
  <ThingDef ParentName="AB2_LinkBase">
    <defName>AB2_Elevator</defName>
    <label>elevator</label>
    <description>A counterweighted elevator shaft connecting every level of the colony through a single 2x2 footprint. Completing it opens all levels it reaches and creates a matching car on each. Colonists ride between any two levels directly, and haul, work, sleep and fight across the connection exactly as they would across a corridor.</description>
    <size>(2,2)</size>
    <!-- Inherit="False" is load-bearing: RimWorld MERGES <li> lists with the parent's
         by default, so without it this became Metallic + the base's Woody and Stony -
         observed as a wooden elevator. -->
    <stuffCategories Inherit="False">
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>150</costStuffCount>
    <graphicData>
      <texPath>Things/Building/AB_Elevator</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <building>
      <blueprintGraphicData>
        <texPath>Things/Building/AB_Elevator</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        <drawSize>(2,2)</drawSize>
      </blueprintGraphicData>
    </building>
    <uiIconPath>Things/Building/AB_Elevator</uiIconPath>
    <modExtensions>
      <li Class="AsAboveSoBelow.ABBandStairsExt">
        <linksAllLevels>true</linksAllLevels>
        <counterpartDef>AB2_Elevator</counterpartDef>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- ======================= grand staircase ======================= -->

  <!-- The wide option, and the answer to stairwell congestion. At 3x3 it presents TWELVE
       cardinal approach cells against the plain staircase's eight and the ladder's four, so
       arriving and departing pawns stop contending for the same tile.

       Transit itself is instantaneous (the wormhole teleports), so "grand" buys throughput
       and looks the part - it does not buy speed. V1's version scaled travel time with
       quality; there is no travel time to scale here.

       NOTE: V1 shipped this at size (2,2) under (3,3) art - the same footprint/art mismatch
       that made the plain staircase unreliable, just less severe. Matched properly here.
       9 door cells is also well beyond vanilla's largest door (the 2x1 Ornate Door), so if
       many-Portal-regions-per-district ever misbehaves this is where it will show; the
       "links armed = N/M cells" line in AB2: band info reports it directly. -->
  <ThingDef ParentName="AB2_LinkBase" Name="AB2_GrandBase" Abstract="True">
    <size>(3,3)</size>
    <costStuffCount>300</costStuffCount>
    <statBases>
      <WorkToBuild>12000</WorkToBuild>
      <Flammability>0</Flammability>
      <Mass>120</Mass>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="AB2_GrandBase">
    <defName>AB2_GrandStairsDown</defName>
    <label>grand staircase down</label>
    <description>A broad staircase leading down. Three cells wide, so colonists going up and down no longer queue for the same step. Completing it opens the basement level below and creates a matching staircase there.</description>
    <graphicData>
      <texPath>Things/Building/AB_GrandStairsDown</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,3)</drawSize>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <building>
      <blueprintGraphicData>
        <texPath>Things/Building/AB_GrandStairsDown</texPath>
        <graphicClass>Graphic_Multi</graphicClass>
        <drawSize>(3,3)</drawSize>
      </blueprintGraphicData>
    </building>
    <uiIconPath>Things/Building/AB_GrandStairsDown</uiIconPath>
    <modExtensions>
      <li Class="AsAboveSoBelow.ABBandStairsExt">
        <levelDelta>-1</levelDelta>
        <counterpartDef>AB2_GrandStairsUp</counterpartDef>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="AB2_GrandBase">
    <defName>AB2_GrandStairsUp</defName>
    <label>grand staircase up</label>
    <description>A broad staircase leading up. Three cells wide, so colonists going up and down no longer queue for the same step. Completing it opens the sky level above and creates a matching staircase there.</description>
    <graphicData>
      <texPath>Things/Building/AB_GrandStairsUp</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,3)</drawSize>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <building>
      <blueprintGraphicData>
        <texPath>Things/Building/AB_GrandStairsUp</texPath>
        <graphicClass>Graphic_Multi</graphicClass>
        <drawSize>(3,3)</drawSize>
      </blueprintGraphicData>
    </building>
    <uiIconPath>Things/Building/AB_GrandStairsUp</uiIconPath>
    <modExtensions>
      <li Class="AsAboveSoBelow.ABBandStairsExt">
        <levelDelta>1</levelDelta>
        <counterpartDef>AB2_GrandStairsDown</counterpartDef>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- ============================ ladders ============================ -->

  <ThingDef ParentName="AB2_LinkBase" Name="AB2_LadderBase" Abstract="True">
    <costStuffCount>25</costStuffCount>
    <statBases>
      <WorkToBuild>900</WorkToBuild>
      <Mass>12</Mass>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="AB2_LadderBase">
    <defName>AB2_LadderDown</defName>
    <label>ladder down</label>
    <description>A cheap ladder leading down. Completing it opens the basement level below and creates a matching ladder there. Cramped: only one cell wide, so traffic queues.</description>
    <!-- Genuinely 1x1, and its art already matches - the ladder was never affected by the
         size mismatch. Left explicit so the contrast with the staircases is deliberate. -->
    <size>(1,1)</size>
    <graphicData>
      <texPath>Things/Building/AB_LadderDown</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <building>
      <blueprintGraphicData>
        <texPath>Things/Building/AB_LadderDown</texPath>
        <graphicClass>Graphic_Multi</graphicClass>
        <drawSize>(1,1)</drawSize>
      </blueprintGraphicData>
    </building>
    <uiIconPath>Things/Building/AB_LadderDown</uiIconPath>
    <modExtensions>
      <li Class="AsAboveSoBelow.ABBandStairsExt">
        <levelDelta>-1</levelDelta>
        <counterpartDef>AB2_LadderUp</counterpartDef>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="AB2_LadderBase">
    <defName>AB2_LadderUp</defName>
    <label>ladder up</label>
    <description>A cheap ladder leading up. Completing it opens the sky level above and creates a matching ladder there. Cramped: only one cell wide, so traffic queues.</description>
    <size>(1,1)</size>
    <graphicData>
      <texPath>Things/Building/AB_LadderUp</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
      <damageData>
        <enabled>false</enabled>
      </damageData>
      <!--
        Carried over from the V1 pass (MORTON's edit): the ladder leans against the wall on
        its facing edge rather than sitting centred in its cell. NORTH and SOUTH are the
        swapped pair from that file, verbatim; east has none and west does not exist,
        because Graphic_Multi mirrors east into west.

        Sign is OPPOSITE to the risers above, and that is not a mistake: a riser is drawn
        toward the open side it faces, while the ladder is pushed back toward the wall it
        rests on.
      -->
      <drawOffsetNorth>(0,0,-0.33)</drawOffsetNorth>
      <drawOffsetSouth>(0,0,0.33)</drawOffsetSouth>
      <drawOffsetEast>(0,0,0)</drawOffsetEast>
    </graphicData>
    <building>
      <blueprintGraphicData>
        <texPath>Things/Building/AB_LadderUp</texPath>
        <graphicClass>Graphic_Multi</graphicClass>
        <drawSize>(1,1)</drawSize>
      </blueprintGraphicData>
    </building>
    <uiIconPath>Things/Building/AB_LadderUp</uiIconPath>
    <modExtensions>
      <li Class="AsAboveSoBelow.ABBandStairsExt">
        <levelDelta>1</levelDelta>
        <counterpartDef>AB2_LadderDown</counterpartDef>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>

<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    CROSS-LEVEL UTILITY RISERS - shared base.

    A riser is placed on one level and pairs with its twin on the level above or below,
    joining the two levels' networks into one. The pairing mechanic is not built yet
    (§30b-d); until it is, a riser behaves as an ordinary member of its own level's
    network, which is a coherent thing to build and cannot break a save.

    ⚠ THIS BASE LIVES IN Defs/ AND IS ALWAYS LOADED, while most of its children live under
    Compat/ and load only with their host mod (see LoadFolders.xml). That is fine and is
    the point: an abstract parent naming only vanilla types is safe everywhere, so every
    gated child can inherit shape, cost and stats from one place instead of repeating them.

    ⚠ A RISER GOES *IN* A WALL, NOT BESIDE ONE. `canPlaceOverWall` + PlaceWorker_ABOnWall,
    modelled directly on VTE_WallMountedVent and vanilla's Vent. The building occupies the
    WALL'S OWN cell and faces out of it into the room.

    ⚠ THE EARLIER `isAttachment` VERSION WAS WRONG AND COULD NOT PLACE AT ALL. RimWorld has
    two unrelated wall-mounted mechanisms:
      isAttachment  - occupies the OPEN cell beside a wall; Rotation points INTO the wall;
                      the wall must declare `supportsWallAttachments`, which ORDINARY COLONY
                      WALLS DO NOT. Only a handful of natural and Anomaly structures do, so
                      attachments silently refuse to place on a normal wall.
      canPlaceOverWall - occupies the WALL's cell; Rotation points OUT into the room.
    Vanilla Vent, VTE's WallMountedVent and WallMountedCooler all use the second.

    ⚠ SO ROTATION IS ORDINARY FACING, AND `_south` IS THE FRONT VIEW AGAIN. Because the
    unit faces out of the wall rather than into it, the usual RimWorld convention applies:
    _south faces the player and shows the front. An `isAttachment` riser would have needed
    the inverted convention; this one does not.

    ⚠ NON-EDIFICE ON PURPOSE. `isEdifice=false` is what lets the riser share its cell with
    the wall instead of replacing it, and `clearBuildingArea=false` is what stops placement
    demolishing that wall. Both are load-bearing - drop either and the riser either cannot
    be placed or eats the structure it is supposed to sit inside.
  -->
  <ThingDef Name="AB_RiserBase" ParentName="BuildingBase" Abstract="True">
    <thingClass>Building</thingClass>
    <category>Building</category>
    <size>(1,1)</size>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.75</fillPercent>
    <blockWind>true</blockWind>
    <blockLight>false</blockLight>
    <canOverlapZones>false</canOverlapZones>
    <rotatable>true</rotatable>
    <selectable>true</selectable>
    <clearBuildingArea>false</clearBuildingArea>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <placeWorkers>
      <li>AsAboveSoBelow.PlaceWorker_ABOnWall</li>
    </placeWorkers>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <constructEffect>ConstructMetal</constructEffect>
    <repairEffect>Repair</repairEffect>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <designationHotKey>Misc4</designationHotKey>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>1100</WorkToBuild>
      <Flammability>0.4</Flammability>
      <Beauty>-3</Beauty>
    </statBases>
    <costList>
      <Steel>35</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <building>
      <isEdifice>false</isEdifice>
      <isInert>true</isInert>
      <canPlaceOverWall>true</canPlaceOverWall>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <!--
      ⚠ THREE FILES, NOT FOUR. Graphic_Multi.Init falls back to _east with westFlipped when
      _west is absent, so north/east/south is a complete set - the same thing Dubs Bad
      Hygiene ships for its own boilers and vents. A hand-authored _west would only be an
      opportunity for the two side views to drift apart.
    -->
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
      <damageData>
        <rect>(0.1,0.1,0.8,0.8)</rect>
      </damageData>
    </graphicData>
  </ThingDef>


  <ThingDef ParentName="AB_RiserBase">
    <defName>AB_PowerJunction</defName>
    <label>power junction box</label>
    <description>A wall-mounted power junction box. It bridges its network to a matching breaker box in the same cell one level above and one level below, merging those levels' networks into this one.\n\nBuild the junction where the machinery is; build a breaker on each level you want to reach.</description>
    <graphicData>
      <texPath>Things/Building/Risers/AB_PowerJunction</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <designationCategory>Power</designationCategory>
    <researchPrerequisites>
      <li>Electricity</li>
    </researchPrerequisites>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>1600</WorkToBuild>
      <Flammability>0.4</Flammability>
      <Beauty>-3</Beauty>
    </statBases>
    <costList>
      <Steel>60</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTransmitter</compClass>
        <transmitsPower>true</transmitsPower>
      </li>
    </comps>
    <modExtensions>
      <li Class="AsAboveSoBelow.ABRiserExt">
        <network>Power</network>
        <role>Junction</role>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="AB_RiserBase">
    <defName>AB_PowerBreaker</defName>
    <label>power breaker box</label>
    <description>A wall-mounted power breaker box. Place it in the same cell as a junction box one level above or below and the two levels' networks merge.\n\nFlick it off to cut the link without deconstructing anything.</description>
    <graphicData>
      <texPath>Things/Building/Risers/AB_PowerBreaker</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <designationCategory>Power</designationCategory>
    <researchPrerequisites>
      <li>Electricity</li>
    </researchPrerequisites>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>900</WorkToBuild>
      <Flammability>0.4</Flammability>
      <Beauty>-3</Beauty>
    </statBases>
    <costList>
      <Steel>25</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTransmitter</compClass>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="CompProperties_Flickable" />
    </comps>
    <modExtensions>
      <li Class="AsAboveSoBelow.ABRiserExt">
        <network>Power</network>
        <role>Breaker</role>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>

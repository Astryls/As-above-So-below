<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    CROSS-LEVEL UTILITY RISERS - shared base.

    A riser is placed on one level and pairs with its twin on the level above or below,
    joining the two levels' networks into one. The pairing mechanic is not built yet
    (§30b-d); until it is, a riser behaves as an ordinary member of its own level's
    network, which is a coherent thing to build and cannot break a save.

    ⚠ THIS BASE LIVES IN Defs/ AND IS ALWAYS LOADED, while most of its children live under
    Compat/ and load only with their host mod (see LoadFolders.xml). That is fine and is
    the point: an abstract parent naming only vanilla types is safe everywhere, so every
    gated child can inherit shape, cost and stats from one place instead of repeating them.

    ⚠ EVERY RISER IS A WALL ATTACHMENT, exactly like vanilla's WallLamp and TorchWallLamp:
    `isAttachment` + `Placeworker_AttachedToWall` + Standable + BuildingOnTop. That keeps
    the floor clear, puts the riser where the conduits and pipes already run, and gets a
    behaviour vanilla already supports - `CompPower.ConnectToTransmitter` resolves an
    attachment's connector position from the WALL it hangs on rather than from its own cell
    (CompPower.cs:199), so a wall-mounted power riser wires up correctly with no help.

    ⚠⚠ ROTATION IS THE DIRECTION OF THE WALL, NOT THE DIRECTION THE UNIT FACES.
    `Placeworker_AttachedToWall` requires a Full-fillage `supportsWallAttachments` building
    at `loc + GenAdj.CardinalDirections[rot.AsInt]`, and CardinalDirections[0] is (0,0,1) -
    north, up the screen. Rot4.North.AsInt is 0 and Graphic_Multi takes mats[0] as _north.
    Therefore:

        _north  wall ABOVE  -> unit hugs the top edge, front face points DOWN, fully seen
        _east   wall RIGHT  -> unit hugs the right edge, front face points LEFT
        _south  wall BELOW  -> unit hugs the bottom edge, we see its BACK
        _west   mirrored from _east automatically

    This is the OPPOSITE of the usual RimWorld habit where _south is the hero front view,
    and it is worth stating loudly because the art cannot tell you it is wrong - swapped
    north/south files simply look like a unit that turns its back when you rotate it.

    ⚠ NON-EDIFICE ON PURPOSE. Risers sit alongside the host mod's own pipes and conduits,
    which are themselves non-edifice and expect to share a cell with walls and floors. An
    edifice riser could not be placed where players will actually want it.
  -->
  <ThingDef Name="AB_RiserBase" ParentName="BuildingBase" Abstract="True">
    <thingClass>Building</thingClass>
    <category>Building</category>
    <size>(1,1)</size>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <passability>Standable</passability>
    <blockWind>false</blockWind>
    <blockLight>false</blockLight>
    <canOverlapZones>false</canOverlapZones>
    <rotatable>true</rotatable>
    <selectable>true</selectable>
    <clearBuildingArea>false</clearBuildingArea>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <placeWorkers>
      <li>Placeworker_AttachedToWall</li>
    </placeWorkers>
    <constructEffect>ConstructMetal</constructEffect>
    <repairEffect>Repair</repairEffect>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <designationHotKey>Misc4</designationHotKey>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>1100</WorkToBuild>
      <Flammability>0.4</Flammability>
      <Beauty>-3</Beauty>
    </statBases>
    <costList>
      <Steel>35</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <building>
      <isEdifice>false</isEdifice>
      <isAttachment>true</isAttachment>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <!--
      ⚠ THREE FILES, NOT FOUR. Graphic_Multi.Init falls back to _east with westFlipped when
      _west is absent, so north/east/south is a complete set - the same thing Dubs Bad
      Hygiene ships for its own boilers and vents. A hand-authored _west would only be an
      opportunity for the two side views to drift apart.
    -->
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
      <damageData>
        <rect>(0.1,0.1,0.8,0.8)</rect>
      </damageData>
    </graphicData>
  </ThingDef>


  <ThingDef ParentName="AB_RiserBase">
    <defName>AB_PowerJunction</defName>
    <label>power junction box</label>
    <description>A wall-mounted power junction box. It bridges its network to a matching breaker box in the same cell one level above and one level below, merging those levels' networks into this one.\n\nBuild the junction where the machinery is; build a breaker on each level you want to reach.</description>
    <graphicData>
      <texPath>Things/Building/Risers/AB_PowerJunction</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <designationCategory>Power</designationCategory>
    <researchPrerequisites>
      <li>Electricity</li>
    </researchPrerequisites>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>1600</WorkToBuild>
      <Flammability>0.4</Flammability>
      <Beauty>-3</Beauty>
    </statBases>
    <costList>
      <Steel>60</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTransmitter</compClass>
        <transmitsPower>true</transmitsPower>
      </li>
    </comps>
    <modExtensions>
      <li Class="AsAboveSoBelow.ABRiserExt">
        <network>Power</network>
        <role>Junction</role>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="AB_RiserBase">
    <defName>AB_PowerBreaker</defName>
    <label>power breaker box</label>
    <description>A wall-mounted power breaker box. Place it in the same cell as a junction box one level above or below and the two levels' networks merge.\n\nFlick it off to cut the link without deconstructing anything.</description>
    <graphicData>
      <texPath>Things/Building/Risers/AB_PowerBreaker</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <designationCategory>Power</designationCategory>
    <researchPrerequisites>
      <li>Electricity</li>
    </researchPrerequisites>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>900</WorkToBuild>
      <Flammability>0.4</Flammability>
      <Beauty>-3</Beauty>
    </statBases>
    <costList>
      <Steel>25</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTransmitter</compClass>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="CompProperties_Flickable" />
    </comps>
    <modExtensions>
      <li Class="AsAboveSoBelow.ABRiserExt">
        <network>Power</network>
        <role>Breaker</role>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
